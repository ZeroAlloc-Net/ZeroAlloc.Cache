<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Cache package with the oldest supported
    .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. The package bundles its generator in
    analyzers/dotnet/cs. A generator built against a newer Roslyn than the compiler that loads it
    is skipped with CS9057, and then AddCustomerServiceCache does not exist, so the build fails with
    CS1061. CS9057 is an error here as well.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      dotnet pack src/ZeroAlloc.Cache -c Release -o artifacts -p:Version=9.9.9-local.sha$(git rev-parse --short HEAD)
      cd tests/ZeroAlloc.Cache.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocCacheVersion=9.9.9-local.sha$(git rev-parse --short HEAD)
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocCacheVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocCacheVersion)' == ''"
           Text="Pass the version of the packed package: -p:ZeroAllocCacheVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Cache" Version="[$(ZeroAllocCacheVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>
</Project>
